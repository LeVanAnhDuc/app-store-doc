DATABASE_URL=
DATABASE_URL_TEST=
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Mật khẩu thô, CHỈ dùng cho Playwright e2e (e2e/content-roundtrip.spec.ts).
# Phải khớp với ADMIN_PASSWORD_HASH ở trên. Đừng khai biến này trên Vercel.
ADMIN_PASSWORD=
PREVIEW_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# BẪY: dấu $ trong .env phải escape thành \$
# ==============================================================================
# Next expand biến trong .env, nên mọi $x bị coi là tên biến và thay bằng rỗng.
# Hash bcrypt LUÔN chứa $, nên để trần thì hash 60 ký tự teo còn 48 và đăng nhập
# luôn báo sai mật khẩu mà không có lỗi nào để lần theo.
#
#   SAI   ADMIN_PASSWORD_HASH=$2b$10$abc...      -> app đọc được 48 ký tự
#   SAI   ADMIN_PASSWORD_HASH='$2b$10$abc...'    -> nháy đơn KHÔNG cứu được
#   ĐÚNG  ADMIN_PASSWORD_HASH=\$2b\$10\$abc...    -> đủ 60 ký tự
#
# Chỉ áp dụng cho file .env. Trên Vercel khai qua dashboard thì không expand,
# dán hash nguyên văn. Xem docs/operations.md mục 4.
# ==============================================================================
